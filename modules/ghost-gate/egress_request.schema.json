{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ghost Gate Egress Request",
  "type": "object",
  "required": ["request_id", "destination", "protocol", "reason"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "destination": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "enum": ["https", "http", "dns", "tcp"]},
    "reason": {"type": "string", "minLength": 1},
    "policy": {"type": "string", "enum": ["direct", "vpn", "tor"]}
  },
  "additionalProperties": false
}
