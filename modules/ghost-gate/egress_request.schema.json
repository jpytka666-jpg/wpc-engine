{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ghost Gate Egress Request",
  "type": "object",
  "required": ["request_id", "mode", "destination", "protocol", "decision"],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "enum": ["OFFLINE", "VPN", "VPN_FIREWALL", "TOR"]},
    "destination": {"type": "string", "minLength": 1},
    "protocol": {"type": "string", "enum": ["https", "http", "dns", "tcp", "udp"]},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "decision": {"type": "string", "enum": ["allow", "deny", "audit"]},
    "dns_policy": {"type": "string", "enum": ["gateway_only", "blocked", "explicit"]},
    "reason": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"mode": {"const": "OFFLINE"}}}, "then": {"properties": {"decision": {"const": "deny"}}}}
  ]
}
