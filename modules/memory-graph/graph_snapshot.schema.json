{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIONS Graph Snapshot",
  "type": "object",
  "required": ["snapshot_id", "nodes", "edges"],
  "properties": {
    "snapshot_id": {
      "type": "string",
      "pattern": "^[a-z0-9._:-]+$"
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "properties": {
          "id": {"type": "string"},
          "type": {
            "type": "string",
            "enum": ["memory", "code_symbol", "process", "agent", "module", "dependency"]
          },
          "version": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "kind"],
        "properties": {
          "id": {"type": "string"},
          "from": {"type": "string"},
          "to": {"type": "string"},
          "kind": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
