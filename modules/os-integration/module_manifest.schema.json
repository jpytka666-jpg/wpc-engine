{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIONS Module Manifest",
  "type": "object",
  "required": ["name", "version", "health", "capabilities"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "health": {"type": "string", "enum": ["starting", "ready", "degraded", "failed"]},
    "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
